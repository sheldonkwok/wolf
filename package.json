{
  "name": "wolf",
  "version": "0.1.0",
  "description": "Bun TypeScript front layer for the wolf werewolf engine",
  "type": "module",
  "private": true,
  "napi": {
    "binaryName": "wolf"
  },
  "scripts": {
    "build": "napi build --platform --release --esm --no-const-enum --manifest-path crates/wolf-napi/Cargo.toml --output-dir ts/native",
    "build:dev": "napi build --platform --esm --no-const-enum --manifest-path crates/wolf-napi/Cargo.toml --output-dir ts/native",
    "cli": "bun ts/cli.ts",
    "slackbot": "bun ts/slackbot.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@napi-rs/cli": "^3.8.6",
    "@types/bun": "^1.4.0"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "undici": "^7.29.1"
  },
  "patchedDependencies": {
    "@slack/socket-mode@3.0.1": "patches/@slack%2Fsocket-mode@3.0.1.patch"
  }
}
